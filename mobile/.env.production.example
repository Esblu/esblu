# mobile/.env.production.example — PRODUCTION closed-beta device build
# (Mobile Platform 2026-10-09). Skopíruj na mobile/.env.local (necommituje sa).
#
#   Supabase: produkcia assetpilot (fkpgvgvsmbpieduoatrt) — rovnaký účet a dáta ako web
#   API:      https://www.esblu.com (NEXT_PUBLIC_ESBLU_API_ORIGIN NEnastavuj)
# Kontrola: node scripts/android-prebuild-check.mjs --target production
#   (staging ref / Preview hostname / mix / service_role v bundli = FAIL)
# Anon / publishable kľúč je verejný (RLS je autorita) — rovnaký ako webový
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Server secrets SEM NIKDY.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ESBLU_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://fkpgvgvsmbpieduoatrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google login iba ak je v produkčnom Supabase redirect com.esblu.app://auth/callback;
# do vtedy prázdne (fail closed — tlačidlo sa nezobrazí).
NEXT_PUBLIC_ESBLU_OAUTH_PROVIDERS=
