<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              HTTPS Android App Links — ÚZKY rozsah, iba pre routy, ktoré
              dnes reálne prichádzajú z e-mailového/zdieľaného odkazu na
              https://esblu.com (pozri MOBILE AUTH + DEEP LINKS audit):

                /invite/*            — invite emailRedirectTo + zdieľaný
                                        invite odkaz (app/invite/[token],
                                        mobile/app/invite?token=...)
                /reset-hesla         — resetPasswordForEmail redirectTo
                /onboarding/company  — owner signup emailRedirectTo
                /auth/callback       — pridané (GOOGLE PLAY RELEASE PRÍPRAVA,
                                        App Links audit): dedikovaný auth
                                        callback (TokenHash revízia,
                                        2026-08-31, app/auth/callback/page.tsx)
                                        — Supabase Email Templates (Confirm
                                        signup, Reset Password) odkazujú
                                        PRIAMO sem s ?token_hash=...&type=...
                                        DeepLinkBridge.resolveEsbluDeepLink()
                                        už tento presný pathname rozpoznávala
                                        (pozri "AUTH CALLBACK BEZPEČNOSTNÁ
                                        OPRAVA" komentár tam) — chýbal iba
                                        tento natívny intent-filter záznam,
                                        bez ktorého Android odkaz appke vôbec
                                        neponúkol. Bez tejto zmeny by
                                        potvrdenie registrácie/reset hesla na
                                        mobile vždy skončilo iba vo web
                                        prehliadači (bezpečný, ale neúplný
                                        fallback) namiesto priamo v appke.

              Zámerne NEPOKRÝVA celú doménu esblu.com (napr. /vozidla,
              /login, marketing landing page atď.) — tie majú zostať bežné
              web odkazy, nikdy sa neotvárajú v appke automaticky. Host je
              iba apex "esblu.com" — appka aj celý zvyšok kódu (lib/public-
              url.ts, lib/api-url.ts) dôsledne generuje/používa výhradne
              https://esblu.com (bez "www."), preto "www.esblu.com" tu
              zámerne nie je pridané (žiadne reálne odkazy naň nesmerujú;
              dá sa doplniť rovnakým vzorom, ak sa to v budúcnosti zmení).

              android:autoVerify="true" spustí Android Digital Asset Links
              verifikáciu voči https://esblu.com/.well-known/assetlinks.json
              pri inštalácii — BEZ platného assetlinks.json (vyžaduje SHA-256
              fingerprint z release keystore, ktorý ešte neexistuje) Android
              verifikáciu buď preskočí, alebo zlyhá a odkazy sa naďalej
              normálne otvoria vo web prehliadači (bezpečný fallback, nie
              broken stav) — pozri report, sekcia G.

              JS-side routing prijatého odkazu na správnu lokálnu statickú
              stránku (vrátane zachovania hash/query s Supabase auth
              parametrami) je implementované v mobile/app/DeepLinkBridge.tsx
              (@capacitor/app — App.getLaunchUrl() pre cold start,
              App.addListener('appUrlOpen', ...) pre foreground/background),
              mountovanom cez mobile/app/layout.tsx. Tento intent-filter
              REGISTRUJE appku ako kandidáta na otvorenie týchto URL v
              Android systéme — bez platného assetlinks.json (pozri vyššie
              a mobile/android/APP_LINKS_ASSETLINKS_TODO.md) Android
              automatickú (autoVerify) voľbu appky nedokončí a odkaz sa
              štandardne otvorí vo web prehliadači; priame otestovanie
              appky samotnej je možné cez `adb shell am start ... -d "https://
              esblu.com/..." com.esblu.app` (explicitný package target
              obchádza Digital Asset Links verifikáciu) — pozri report.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="esblu.com" />
                <data android:pathPrefix="/invite" />
                <data android:path="/reset-hesla" />
                <data android:path="/onboarding/company" />
                <data android:path="/auth/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      RECORD_AUDIO — hlasové vyhľadávanie (zadanie, sekcia B/C/E: mikrofón
      v existujúcom centrálnom search poli, ako tenká vstupná vrstva nad
      Intent Enginom). Bez tohto manifest záznamu Android runtime permission
      dialóg pre getUserMedia({ audio: true }) v Capacitor WebView vôbec
      nezobrazí a nahrávanie by v natívnej appke vždy zlyhalo (na rozdiel od
      mobilného webu/PWA, kde permission rieši samotný prehliadač).

      Žiadny nový Capacitor plugin nie je potrebný — Capacitor Android
      štandardne (od Capacitor 3+) prepája WebView
      onPermissionRequest/PermissionRequest udalosti na natívny Android
      runtime-permission dialóg pre médiá (kameru aj mikrofón) sám, pokiaľ
      je príslušné <uses-permission> deklarované v manifeste (presne ako
      appka dnes už robí pre kameru cez natívny súborový picker/FileProvider
      vyššie) — appka preto NEPOTREBUJE vlastný natívny plugin ani ručné
      volanie Capacitor Permissions API iba kvôli tomuto jednému
      getUserMedia() volaniu v štandardnom WebView `<input>`/JS flow.
      capacitor.config.ts nemá nastavený `server.url` (appka beží nad
      lokálne zabalenými assetmi vlastnej https://localhost schémy), takže
      getUserMedia už dnes beží v bezpečnom (HTTPS-ekvivalentnom) kontexte
      bez ďalšej konfigurácie — pozri report, sekcia E.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
