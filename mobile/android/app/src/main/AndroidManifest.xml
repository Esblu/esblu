<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              ANDROID APP LINKS (Mobile M0, 2026-09-27)

              Host: https://www.esblu.com — kanonický produkčný host.
              Apex https://esblu.com odpovedá 308 → www (aj pre
              /.well-known/*) a Android verifikácia presmerovanie
              nenasleduje, preto apex ZÁMERNE NIE JE registrovaný.

              Verifikácia (android:autoVerify="true") beží voči
              https://www.esblu.com/.well-known/assetlinks.json, ktorý web
              slúži priamo (200, application/json, bez presmerovania).

              Registrované sú iba tieto cesty (nie celá doména):
                /invite, /invite/*    — pozvánka do firmy
                /reset-hesla          — reset hesla
                /onboarding/company   — onboarding vlastníka
                /auth/callback        — potvrdenie e-mailu / recovery
                                        (token_hash z Supabase šablón)
              Prijatý odkaz spracuje mobile/app/DeepLinkBridge.tsx
              (resolveEsbluDeepLink v deep-link-resolve.ts: presný host,
              iba https, iba tieto cesty, token pozvánky 64 hex); čokoľvek
              iné sa v appke ignoruje.

              Podpisové certifikáty:
                - lokálny debug APK sa NEoverí automaticky — jeho debug
                  certifikát nie je (a nesmie byť) v produkčnom
                  assetlinks.json; debug fingerprint sa do produkcie
                  NEPRIDÁVA,
                - testovanie na zariadení s debug buildom: adb override
                  (pm set-app-links-user-selection … www.esblu.com) alebo
                  explicitný package cieľ (am start … com.esblu.app),
                - fingerprint release / Play App Signing certifikátu treba
                  pred vydaním v obchode overiť samostatne voči
                  assetlinks.json (pozri mobile/android/APP_LINKS_ASSETLINKS_TODO.md).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" android:host="www.esblu.com" />
                <data android:path="/invite" />
                <data android:pathPrefix="/invite/" />
                <data android:path="/reset-hesla" />
                <data android:path="/onboarding/company" />
                <data android:path="/auth/callback" />
            </intent-filter>

            <!-- Mobile Platform (2026-10-08): návrat OAuth (PKCE) zo systémového
                 prehliadača — com.esblu.app://auth/callback. Iba táto cesta;
                 DeepLinkBridge/deep-link-resolve prepustí výlučne ju. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.esblu.app" android:host="auth" android:path="/callback" />
            </intent-filter>

        </activity>

        <!--
          PUSH (2026-10-01): predvolený kanál FCM notifikácií. Kanál
          "esblu_default" vytvára appka (lib/push/native.ts) pred registráciou;
          server ho posiela v android.notification.channel_id.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="esblu_default" />

        <!--
          Notifikačná ikona (2026-10-09): monochrómny symbol Esblu bez textu
          (status bar vyžaduje bielu siluetu, inak Android ukáže sivý štvorec).
          Generuje scripts/generate-mobile-assets.py z finálnej master ikony.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_esblu" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/esblu_notification_accent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      PUSH (2026-10-01): Android 13+ runtime povolenie na notifikácie.
      Žiada sa IBA po ťuknutí na „Zapnúť upozornenia" v Nastaveniach
      (@capacitor/push-notifications requestPermissions), nikdy pri štarte.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      RECORD_AUDIO — hlasové vyhľadávanie (zadanie, sekcia B/C/E: mikrofón
      v existujúcom centrálnom search poli, ako tenká vstupná vrstva nad
      Intent Enginom). Bez tohto manifest záznamu Android runtime permission
      dialóg pre getUserMedia({ audio: true }) v Capacitor WebView vôbec
      nezobrazí a nahrávanie by v natívnej appke vždy zlyhalo (na rozdiel od
      mobilného webu/PWA, kde permission rieši samotný prehliadač).

      Žiadny nový Capacitor plugin nie je potrebný — Capacitor Android
      štandardne (od Capacitor 3+) prepája WebView
      onPermissionRequest/PermissionRequest udalosti na natívny Android
      runtime-permission dialóg pre médiá (kameru aj mikrofón) sám, pokiaľ
      je príslušné <uses-permission> deklarované v manifeste (presne ako
      appka dnes už robí pre kameru cez natívny súborový picker/FileProvider
      vyššie) — appka preto NEPOTREBUJE vlastný natívny plugin ani ručné
      volanie Capacitor Permissions API iba kvôli tomuto jednému
      getUserMedia() volaniu v štandardnom WebView `<input>`/JS flow.
      capacitor.config.ts nemá nastavený `server.url` (appka beží nad
      lokálne zabalenými assetmi vlastnej https://localhost schémy), takže
      getUserMedia už dnes beží v bezpečnom (HTTPS-ekvivalentnom) kontexte
      bez ďalšej konfigurácie — pozri report, sekcia E.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      MOBILE M0 (2026-09-27): Capacitor BridgeWebChromeClient.onPermissionRequest
      pri getUserMedia({audio}) žiada NARAZ MODIFY_AUDIO_SETTINGS aj
      RECORD_AUDIO a mikrofón WebView povolí iba ak sú udelené OBE.
      Nedeklarované povolenie Android vráti ako zamietnuté, takže bez tohto
      riadku bol mikrofón v appke vždy zamietnutý. Ide o "normal" povolenie
      (bez dialógu pre používateľa).
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      MOBILE M0: package visibility (Android 11+). Capacitor pri
      <input type="file" accept="image/*" capture> overuje
      ACTION_IMAGE_CAPTURE cez resolveActivity(); bez tejto deklarácie
      vráti null a namiesto fotoaparátu sa otvorí výber súborov.
      Povolenie CAMERA sa zámerne NEPRIDÁVA — IMAGE_CAPTURE intent ho
      nepotrebuje (a deklarované CAMERA by naopak vyžadovalo runtime
      dialóg pred každým zachytením).
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
