# -----------------------------------------------------------------------------
# mobile/.env.staging.example — STAGING device build (Mobile Platform 2026-10-09)
# Skopíruj na mobile/.env.local. Necommituje sa skutočný súbor (.env.local).
#
# Prvý test na zariadení beží IBA proti stagingu:
#   Supabase: esblu-test (cjbdijbbcujvmrzezusd)
#   API:      Vercel Preview vetvy mobile-platform
# Kontrola: node scripts/android-prebuild-check.mjs --target staging
#   (mixed staging / produkcia = FAIL)
# Anon / publishable kľúč je verejný identifikátor (RLS je autorita) — vlož
# ho z Supabase → esblu-test → Settings → API. Server secrets SEM NIKDY.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ESBLU_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://cjbdijbbcujvmrzezusd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ESBLU_API_ORIGIN=https://mobile-staging.esblu.com
# Google login iba ak je v esblu-test zapnutý Google provider + redirect
# com.esblu.app://auth/callback; inak nechať prázdne.
NEXT_PUBLIC_ESBLU_OAUTH_PROVIDERS=
